rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && userDoc().data.active == true;
    }

    function isAdmin() {
      return activeUser() && userDoc().data.role == 'admin';
    }

    function isTeacher() {
      return activeUser() && userDoc().data.role == 'guru';
    }

    function isHomeroom() {
      return isTeacher() && userDoc().data.isHomeroom == true;
    }

    function chatGroupAllowed(groupId) {
      return activeUser() && (
        groupId == 'announcements'
        || groupId == 'all-teachers'
        || (
          groupId == 'homerooms'
          && (isAdmin() || isHomeroom())
        )
        || (
          groupId == 'grade-7'
          && (
            isAdmin()
            || (
              isHomeroom()
              && userDoc().data.homeroomClass.matches('^7.*')
            )
          )
        )
        || (
          groupId == 'grade-8'
          && (
            isAdmin()
            || (
              isHomeroom()
              && userDoc().data.homeroomClass.matches('^8.*')
            )
          )
        )
        || (
          groupId == 'grade-9'
          && (
            isAdmin()
            || (
              isHomeroom()
              && userDoc().data.homeroomClass.matches('^9.*')
            )
          )
        )
      );
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'loginId','name','role','approved','active','rejected',
          'requestedType','requestedHomeroomClass',
          'isHomeroom','homeroomClass','createdAt'
        ])
        && request.resource.data.loginId is string
        && request.resource.data.name is string
        && request.resource.data.role == 'guru'
        && request.resource.data.approved == false
        && request.resource.data.active == false
        && request.resource.data.rejected == false
        && request.resource.data.requestedType in ['guru','wali']
        && request.resource.data.isHomeroom == false
        && request.resource.data.homeroomClass == ''
      );

      allow update, delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }

    match /records/{recordId} {
      allow read: if activeUser();

      allow create: if
        (isTeacher() || isAdmin())
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.lastEditedByUid == request.auth.uid;

      allow update: if
        request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.date == resource.data.date
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.lastEditedByUid == request.auth.uid
        && (
          isAdmin()
          || (
            isTeacher()
            && resource.data.createdByUid == request.auth.uid
            && (
              !resource.data.keys().hasAny(['teacherEditCount'])
              || resource.data.teacherEditCount == 0
            )
            && request.resource.data.teacherEditCount == 1
          )
        );

      allow delete: if isAdmin();
    }

    match /cleanliness/{checkId} {
      allow read: if activeUser();

      allow create: if
        (isAdmin() || isTeacher())
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.lastEditedByUid == request.auth.uid
        && (
          isAdmin()
          || userDoc().data.isHomeroom != true
          || request.resource.data.classId != userDoc().data.homeroomClass
          || get(/databases/$(database)/documents/settings/access).data.homeroomCleanlinessEnabled == true
        );

      allow update: if
        request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.date == resource.data.date
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.jp == resource.data.jp
        && request.resource.data.lastEditedByUid == request.auth.uid
        && (
          isAdmin()
          || (
            isTeacher()
            && resource.data.createdByUid == request.auth.uid
            && (
              !resource.data.keys().hasAny(['teacherEditCount'])
              || resource.data.teacherEditCount == 0
            )
            && request.resource.data.teacherEditCount == 1
            && (
              userDoc().data.isHomeroom != true
              || request.resource.data.classId != userDoc().data.homeroomClass
              || get(/databases/$(database)/documents/settings/access).data.homeroomCleanlinessEnabled == true
            )
          )
        );

      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    // Admin melihat semua periode. Wali Kelas hanya dokumen yang sudah dibagikan.
    match /analysisPeriods/{periodId} {
      allow read: if isAdmin()
        || (isHomeroom() && resource.data.sharedToHomeroom == true);
      allow create, update, delete: if isAdmin();
    }

    // Snapshot lama sebelum hitung ulang. Hanya Admin.
    match /analysisPeriodRevisions/{revisionId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Riwayat perubahan administratif. Hanya Admin dan immutable.
    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Arsip pendataan sebelum reset. Hanya Admin dan immutable.
    match /recordResetArchive/{archiveId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Arsip pemeriksaan kebersihan sebelum reset. Hanya Admin dan immutable.
    match /cleanlinessResetArchive/{archiveId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }


    // =====================================================
    // ECOCHAT
    // =====================================================

    // Pesan grup. Query aplikasi selalu memakai where(groupId == ...).
    match /chatMessages/{messageId} {
      allow read: if chatGroupAllowed(resource.data.groupId);

      // Pesan biasa memakai UID pengirim.
      // Pesan EcoBot hanya dapat dibuat oleh Admin dan memakai senderUid='ecobot'.
      allow create: if activeUser()
        && chatGroupAllowed(request.resource.data.groupId)
        && (
          (
            request.resource.data.type == 'bot'
            && isAdmin()
            && request.resource.data.senderUid == 'ecobot'
          )
          || (
            request.resource.data.type != 'bot'
            && request.resource.data.senderUid == request.auth.uid
            && (
              request.resource.data.groupId != 'announcements'
              || isAdmin()
            )
          )
        );

      // Admin boleh moderasi/edit/pin semua pesan yang dapat diakses.
      // Pengirim pesan teks juga boleh mengubah isi atau melakukan soft-delete
      // pada pesannya sendiri. Identitas, grup, tipe, dan waktu awal tidak boleh diubah.
      // Batas edit 15 menit diterapkan di UI karena createdAtISO tersimpan sebagai string;
      // Rules tetap membatasi field yang dapat disentuh pengguna.
      allow update: if (
        isAdmin()
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.senderUid == resource.data.senderUid
      ) || (
        activeUser()
        && resource.data.senderUid == request.auth.uid
        && resource.data.type == 'text'
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAtISO == resource.data.createdAtISO
        && request.resource.data.createdAtMs == resource.data.createdAtMs
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'text','editedAt','editedByUid','editedByName',
          'deletedAt','deletedByUid','deletedByName','deletedByRole'
        ])
      );

      // Pengguna dapat menghapus pesan miliknya sendiri.
      // Admin tetap dapat menghapus untuk moderasi jika diperlukan.
      allow delete: if isAdmin()
        || (
          activeUser()
          && resource.data.senderUid == request.auth.uid
        );
    }

    // Reaksi 👍 ✅ 👀 disimpan terpisah agar pesan asli tidak dapat
    // dimodifikasi pengguna lain.
    match /chatReactions/{reactionId} {
      allow read: if chatGroupAllowed(resource.data.groupId);

      allow create: if activeUser()
        && request.resource.data.uid == request.auth.uid
        && chatGroupAllowed(request.resource.data.groupId);

      allow update: if false;

      allow delete: if isAdmin()
        || (
          activeUser()
          && resource.data.uid == request.auth.uid
        );
    }

    // Status baca milik pengguna sendiri.
    match /chatReads/{readId} {
      allow read: if activeUser()
        && (
          resource.data.uid == request.auth.uid
          || isAdmin()
        );

      allow create: if activeUser()
        && request.resource.data.uid == request.auth.uid
        && chatGroupAllowed(request.resource.data.groupId);

      allow update: if activeUser()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.groupId == resource.data.groupId
        && chatGroupAllowed(request.resource.data.groupId);

      allow delete: if isAdmin()
        || (
          activeUser()
          && resource.data.uid == request.auth.uid
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
