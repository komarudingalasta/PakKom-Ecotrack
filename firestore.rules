rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function activeUser() { return signedIn() && userDoc().data.active == true; }
    function isAdmin() { return activeUser() && userDoc().data.role == 'admin'; }
    function isTeacher() { return activeUser() && userDoc().data.role == 'guru'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }

    match /records/{recordId} {
      allow read: if activeUser();
      allow create: if (isTeacher() || isAdmin())
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.lastEditedByUid == request.auth.uid;
      allow update: if (isTeacher() || isAdmin())
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.date == resource.data.date
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.lastEditedByUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
